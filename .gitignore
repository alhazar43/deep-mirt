.vscode/

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
.venv/

# PyTorch checkpoints (large binaries, keep in outputs but not in git)
*.pt
*.pth

# Migration regression snapshots are tiny (<1 MB each) and need to ship
# with the test suite, so they override the *.pt ignore above.
!ma-irt/tests/snapshots/*.pt

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.spl
*.synctex.gz
*.toc

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Legacy codebases, archives, and reference reading.
# All of these now live under legacy/ at the repo root and are kept out of
# the public repo. Anything moved under legacy/ is automatically ignored.
legacy/

# Manuscript/reference artifacts outside the tracked paper tree
ma-irt/*.pdf

# Claude internal
.claude/

# Archived code (dead scripts, old configs).
# Specific files inside (e.g. archive/models/components/embeddings.py)
# are force-added with `git add -f` so they ship in the public repo;
# everything else under archive/ stays out.
ma-irt/archive/

# Working documents and planning markdowns (session notes, design
# drafts, refactor TODO lists). Top-level docs/*.md (architecture,
# pipeline, taxonomy) stay tracked as public-facing reference docs.
docs/cleanup/
# docs/archive/ contents are ignored, with an exception for jobrec so
# the pivot from job-recommendation to item-recommendation is
# traceable in version control. See docs/archive/jobrec/README.md.
docs/archive/*
!docs/archive/jobrec
!docs/archive/jobrec/**

# Root-level planning/working markdowns. Only README.md stays
# tracked as the public-facing entry point.
CLAUDE.md
CLEANUP_PLAN_2026.md
CLEANUP_VERIFICATION_2026.md
cleanup_log.md
CONTRIBUTING.md
benchmarks.md

